# Configure these in the hosting dashboard, not in public client code.
DATABASE_URL=postgresql://operator-supplied-user:operator-supplied-password@db.example.com/phoneunlock
# For Aiven, paste the complete CA certificate from the service Overview, including PEM headers.
DATABASE_CA_PEM=
FIREBASE_PROJECT_ID=your-firebase-project-id
# Minified service-account JSON from Firebase; keep private and restrict access.
FIREBASE_SERVICE_ACCOUNT_JSON=
